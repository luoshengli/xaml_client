<Window x:Class="xaml_client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:xaml_client"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.ColumnSpan="2" Margin="10,3" VerticalAlignment="Center">
            <Button x:Name="btn_load" Content="预览" MinWidth="80" Padding="5" Margin="10,0" Click="btn_load_Click"/>
            <TextBlock x:Name="tb_info" />
        </StackPanel>
        <TextBox x:Name="rb_xaml" Grid.Row="1" Grid.Column="0" MaxLength="2147483647" AcceptsReturn="True" AcceptsTab="True" IsManipulationEnabled="True"/>
        <Border x:Name="b_result" Grid.Row="1" Grid.Column="1"/>
    </Grid>
</Window>
